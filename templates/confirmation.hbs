<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>We received your message</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f6f7fb;
        color: #1d2330;
        font-family: "Helvetica Neue", Arial, sans-serif;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 32px 20px 48px;
      }
      .card {
        background: #ffffff;
        border-radius: 12px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(25, 35, 60, 0.08);
      }
      h1 {
        font-size: 22px;
        margin: 0 0 16px;
      }
      p {
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 16px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <h1>Thanks{{#if userName}}, {{userName}}{{/if}}!</h1>
        <p>We received your submission and will get back to you shortly.</p>
        <p>If you need to add anything, just reply to this email.</p>
      </div>
    </div>
  </body>
</html>
