<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>New form submission</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f4f2;
        color: #1e1e1e;
        font-family: "Helvetica Neue", Arial, sans-serif;
      }
      .container {
        max-width: 640px;
        margin: 0 auto;
        padding: 28px 20px 40px;
      }
      .card {
        background: #ffffff;
        border-radius: 10px;
        padding: 24px;
        box-shadow: 0 10px 24px rgba(20, 20, 20, 0.08);
      }
      h1 {
        font-size: 20px;
        margin: 0 0 16px;
      }
      p {
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 12px;
      }
      .label {
        font-weight: 600;
        color: #2c3c57;
      }
      .message {
        border: 1px solid #e4e6eb;
        border-radius: 8px;
        padding: 14px 16px;
        background: #fafafa;
        white-space: pre-line;
        font-size: 14px;
      }
      .meta {
        margin-top: 18px;
        font-size: 12px;
        color: #6c7486;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <h1>New form submission</h1>
        <p><span class="label">Name:</span> {{userName}}</p>
        <p><span class="label">Email:</span> {{userEmail}}</p>
        {{#if userSubject}}
          <p><span class="label">Subject:</span> {{userSubject}}</p>
        {{/if}}
        <p class="label">Message:</p>
        <div class="message">{{userMessage}}</div>
        <div class="meta">Submitted at {{submittedAt}}.</div>
      </div>
    </div>
  </body>
</html>
