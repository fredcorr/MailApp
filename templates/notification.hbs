<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>New form submission</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f4f2;
        color: #1e1e1e;
        font-family: "Helvetica Neue", Arial, sans-serif;
      }
      .container {
        max-width: 640px;
        margin: 0 auto;
        padding: 28px 20px 40px;
      }
      .card {
        background: #ffffff;
        border-radius: 10px;
        padding: 24px;
        box-shadow: 0 10px 24px rgba(20, 20, 20, 0.08);
      }
      h1 {
        font-size: 20px;
        margin: 0 0 16px;
      }
      p {
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 12px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 8px;
      }
      th,
      td {
        text-align: left;
        padding: 10px 12px;
        vertical-align: top;
      }
      th {
        width: 34%;
        font-weight: 600;
        color: #2c3c57;
        background: #f6f7f9;
        border: 1px solid #e4e6eb;
      }
      td {
        border: 1px solid #e4e6eb;
        background: #ffffff;
        white-space: pre-line;
        word-break: break-word;
      }
      .meta {
        margin-top: 18px;
        font-size: 12px;
        color: #6c7486;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <h1>New form submission</h1>
        {{#if hasFields}}
          <table role="presentation">
            <tbody>
              {{#each fields}}
                <tr>
                  <th>{{key}}</th>
                  <td>{{value}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <p>No form fields were included with this submission.</p>
        {{/if}}
        <div class="meta">Submitted at {{submittedAt}}.</div>
      </div>
    </div>
  </body>
</html>
